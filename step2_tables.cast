[6.625, "o", "\u001b[7mrm -f db_meta.json && rm -rf data\u001b[27m\u001b[K\r\r\n\u001b[7muv run database\u001b[27m\u001b[K"]
[0.344, "o", "\u001b[A\u001b[46C\u001b[27mr\u001b[27mm\u001b[27m \u001b[27m-\u001b[27mf\u001b[27m \u001b[27md\u001b[27mb\u001b[27m_\u001b[27mm\u001b[27me\u001b[27mt\u001b[27ma\u001b[27m.\u001b[27mj\u001b[27ms\u001b[27mo\u001b[27mn\u001b[27m \u001b[27m&\u001b[27m&\u001b[27m \u001b[27mr\u001b[27mm\u001b[27m \u001b[27m-\u001b[27mr\u001b[27mf\u001b[27m \u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[1B\r\u001b[27mu\u001b[27mv\u001b[27m \u001b[27mr\u001b[27mu\u001b[27mn\u001b[27m \u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27mb\u001b[27ma\u001b[27ms\u001b[27me"]
[0.001, "o", "\u001b[?1l\u001b>"]
[0.001, "o", "\u001b[?25l"]
[0.000, "o", "\u001b[?2004l\u001b[A\r\r\u001b[0m\u001b[27m\u001b[24m\u001b[J\u001b[0m\u001b[49m\u001b[27m\u001b[24m\u001b[38;5;76m❯\u001b[0m\u001b[38;5;76m\u001b[49m\u001b[39m\u001b[27m\u001b[24m rm -f db_meta.json && rm -rf data\u001b[K\r\r\nuv run database\u001b[K\u001b[?25h"]
[0.001, "o", "\r\r\n"]
[0.001, "o", "\u001b]2;rm -f db_meta.json && rm -rf data; uv run database\u0007\u001b]1;rm\u0007"]
[0.147, "o", "\r\n***Операции с данными***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\n<command> select from <имя_таблицы> - прочитать все записи\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию\r\n<command> update <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение> - обновить запись\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись\r\n<command> info <имя_таблицы> - вывести информаци"]
[0.000, "o", "ю о таблице\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[0.000, "o", ">>>Введите команду: "]
[6.013, "o", "create_table users name:str age:int is_active:bool"]
[0.445, "o", "\r\n"]
[0.000, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[0.002, "o", ">>>Введите команду: "]
[3.875, "o", "insert into users values (\"Sergei\", 28, true)"]
[0.183, "o", "\r\n"]
[0.001, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[0.012, "o", "Функция insert выполнилась за 0.000 секунд.\r\n>>>Введите команду: "]
[3.892, "o", "insert into users values (\"Anna\", 22, false)"]
[0.279, "o", "\r\n"]
[0.001, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\nФункция insert выполнилась за 0.000 секунд.\r\n"]
[0.000, "o", ">>>Введите команду: "]
[10.747, "o", "insert into users values (\"Petr\", \"тридцать\", true)"]
[0.420, "o", "\r\n"]
[0.001, "o", "Некорректное значение: тридцать. Попробуйте снова.\r\nФункция insert выполнилась за 0.000 секунд.\r\n"]
[0.001, "o", ">>>Введите команду: "]
[4.483, "o", "insert into users values (\"Petr\", 30)"]
[0.476, "o", "\r\n"]
[0.000, "o", "Ошибка: количество значений не соответствует количеству столбцов в таблице \"users\".\r\nФункция insert выполнилась за 0.000 секунд.\r\n"]
[0.001, "o", ">>>Введите команду: "]
[7.294, "o", "select from users"]
[0.386, "o", "\r\n"]
[0.001, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[0.098, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  22 |   False   |\r\n+----+--------+-----+-----------+\r\n>>>Введите команду: "]
[10.329, "r", "117x8"]
[2.795, "o", "select from users where age = 28"]
[0.706, "o", "\r\n"]
[0.001, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[0.001, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[0.000, "o", ">>>Введите команду: "]
[1.169, "r", "117x26"]
[15.805, "o", "select from users where name = \"Anna\""]
[0.405, "o", "\r\n"]
[0.001, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[0.000, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n| 2  | Anna |  22 |   False   |\r\n+----+------+-----+-----------+\r\n"]
[0.000, "o", ">>>Введите команду: "]
[4.028, "o", "update users set age = 29 where name = \"Sergei\""]
[0.311, "o", "\r\n"]
[0.002, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[0.001, "o", ">>>Введите команду: "]
[11.903, "o", "select from users where name = \"Sergei\""]
[0.842, "o", "\r\n"]
[0.000, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[0.001, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[0.000, "o", ">>>Введите команду: "]
[4.515, "o", "delete from users where ID = 2"]
[0.290, "o", "\r\n"]
[0.001, "o", "Вы уверены, что хотите выполнить \"удаление записи\"? [y/n]: "]
[1.533, "o", "y"]
[0.674, "o", "\r\n"]
[0.001, "o", "Запись с ID=2 успешно удалена из таблицы \"users\".\r\n"]
[0.001, "o", ">>>Введите команду: "]
[6.098, "o", "select from users"]
[0.333, "o", "\r\n"]
[0.001, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[0.000, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[0.000, "o", ">>>Введите команду: "]
[7.017, "o", "info users"]
[0.651, "o", "\r\n"]
[0.001, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 1\r\n"]
[0.000, "o", ">>>Введите команду: "]
[4.623, "r", "117x8"]
[1.692, "o", "drop_table users"]
[0.447, "o", "\r\n"]
[0.001, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[1.250, "o", "y"]
[2.969, "o", "\b \b"]
[0.391, "o", "n"]
[0.403, "o", "\r\n"]
[0.000, "o", "Операция отменена.\r\n"]
[0.001, "o", ">>>Введите команду: "]
[2.222, "o", "drop_table users"]
[0.867, "o", "\r\n"]
[0.000, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[0.658, "o", "y"]
[0.592, "o", "\r\n"]
[0.001, "o", "Таблица \"users\" успешно удалена.\r\n"]
[0.001, "o", ">>>Введите команду: "]
[5.041, "o", "list_tables"]
[0.338, "o", "\r\n"]
[0.000, "o", "Таблиц нет\r\n"]
