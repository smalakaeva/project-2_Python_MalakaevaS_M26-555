[0.317, "o", "\u001b[15D\u001b[27mu\u001b[27mv\u001b[27m \u001b[27mr\u001b[27mu\u001b[27mn\u001b[27m \u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27mb\u001b[27ma\u001b[27ms\u001b[27me"]
[0.001, "o", "\u001b[?1l\u001b>"]
[0.001, "o", "\u001b[?25l"]
[0.000, "o", "\u001b[?2004l\r\r\u001b[0m\u001b[27m\u001b[24m\u001b[J\u001b[0m\u001b[49m\u001b[27m\u001b[24m\u001b[38;5;76m❯\u001b[0m\u001b[38;5;76m\u001b[49m\u001b[39m\u001b[27m\u001b[24m uv run database\u001b[K\u001b[?25h"]
[0.000, "o", "\r\r\n"]
[0.001, "o", "\u001b]2;uv run database\u0007\u001b]1;uv\u0007"]
[1.136, "o", "\r\n***Операции с данными***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\n<command> select from <имя_таблицы> - прочитать все записи\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию\r\n"]
[0.000, "o", "<command> update <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение> - обновить запись\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись\r\n<command> info <имя_таблицы> - вывести информацию о таблице\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[0.000, "o", ">>>Введите команду: "]
[4.318, "o", "create_table users name:str age:int is_active:bool"]
[0.358, "o", "\r\n"]
[0.001, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[0.000, "o", ">>>Введите команду: "]
[3.290, "o", "create_table users name:str"]
[0.343, "o", "\r\n"]
[0.000, "o", "Ошибка: Таблица \"users\" уже существует.\r\n"]
[0.001, "o", ">>>Введите команду: "]
[3.561, "o", "create_table products price:float"]
[0.262, "o", "\r\n"]
[0.000, "o", "Некорректный тип данных. Попробуйте снова.\r\n"]
[0.001, "o", ">>>Введите команду: "]
[10.309, "o", "list_tables"]
[0.725, "o", "\r\n"]
[0.000, "o", "- users\r\n"]
[0.000, "o", ">>>Введите команду: "]
[4.008, "o", "create_table products title:str price:int"]
[0.393, "o", "\r\n"]
[0.000, "o", "Таблица \"products\" успешно создана со столбцами: ID:int, title:str, price:int\r\n"]
[0.002, "o", ">>>Введите команду: "]
[3.322, "o", "list_tables"]
[0.198, "o", "\r\n"]
[0.000, "o", "- users\r\n- products\r\n"]
[0.000, "o", ">>>Введите команду: "]
[3.445, "o", "drop_table orders"]
[0.308, "o", "\r\n"]
[0.000, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[1.220, "o", "н"]
[0.765, "o", "\b \b"]
[0.597, "o", "y"]
[0.437, "o", "\r\n"]
[0.002, "o", "Операция отменена.\r\n"]
[0.001, "o", ">>>Введите команду: "]
[4.362, "o", "drop_table products"]
[0.286, "o", "\r\n"]
[0.000, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[7.270, "o", "y"]
[1.572, "o", "\b \b"]
[0.808, "o", "y"]
[0.555, "o", "\r\n"]
[0.000, "o", "Таблица \"products\" успешно удалена.\r\n"]
[0.001, "o", ">>>Введите команду: "]
[5.383, "o", "list_tables"]
[0.356, "o", "\r\n"]
[0.000, "o", "- users\r\n"]
[0.000, "o", ">>>Введите команду: "]
[3.180, "o", "help"]
[0.510, "o", "\r\n"]
[0.000, "o", "\r\n***Операции с данными***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n"]
[0.000, "o", "<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\n<command> select from <имя_таблицы> - прочитать все записи\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию\r\n<command> update <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение> - обновить запись\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись\r\n<command> info <имя_таблицы> - вывести информацию о таблице\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[0.000, "o", ">>>Введите команду: "]
[1.744, "o", "b"]
[0.120, "o", "l"]
[0.128, "o", "a"]
[0.115, "o", "l"]
[0.117, "o", "a"]
[0.094, "o", "l"]
[0.146, "o", "a"]
[0.032, "o", "l"]
[0.171, "o", "a"]
[0.006, "o", "l"]
[0.185, "o", "l"]
[0.019, "o", "a"]
[0.276, "o", "\r\n"]
[0.000, "o", "Функции blalalalalla нет. Попробуйте снова.\r\n"]
[0.001, "o", ">>>Введите команду: "]
[3.541, "o", "exit"]
[0.303, "o", "\r\n"]
